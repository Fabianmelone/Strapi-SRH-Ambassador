{
  "kind": "collectionType",
  "collectionName": "addresses",
  "info": {
    "singularName": "address",
    "pluralName": "addresses",
    "displayName": "Address"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "building_number": {
      "type": "integer"
    },
    "City": {
      "type": "string"
    },
    "Country": {
      "type": "string"
    },
    "street_name": {
      "type": "string"
    },
    "postal_code": {
      "type": "integer"
    },
    "location": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::location.location",
      "inversedBy": "address"
    }
  }
}
